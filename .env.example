APP_PORT=8080
API_PORT=8000
AI_PORT=8001
CHROMA_PORT=8002
MYSQL_PORT=3306
MYSQL_DATABASE=flts
MYSQL_USER=flts
MYSQL_PASSWORD=flts_secret
MYSQL_ROOT_PASSWORD=root_secret
# Laravel's authoritative file validation limit; keep it aligned with backend/Dockerfile and nginx.conf.
DOCUMENT_MAX_KB=10240
MAILPIT_PORT=8025

# Mail configuration (Default: local Mailpit; for Gmail SMTP, see instructions in README)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@flts.test
MAIL_FROM_NAME=FLTS

# Sprint 2 RAG: keep both values local. Never commit a real Gemini key.
# Generate a different high-entropy value locally for API <-> AI service authentication.
AI_SERVICE_TOKEN=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_BATCH_SIZE=40
GEMINI_EMBEDDING_MAX_RETRIES=15
# Retrieval/evidence are interactive. Fail quickly on a provider 429 instead of holding the browser request.
GEMINI_QUERY_MAX_RETRIES=1
CHROMA_COLLECTION=flts_document_chunks
